<?xml version="1.0"?>
<!-- base_link: on the floor, midway between the wheel contact points, x forward, z up. -->
<!-- Wheel radius and separation must match bridge.yaml. The geometries are for display only. -->
<robot name="hoverboard_robot">
  <link name="base_link"/>

  <link name="chassis_link">
    <visual>
      <geometry><box size="0.59 0.30 0.02"/></geometry>
    </visual>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0.175 0 0.09"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.132" length="0.075"/></geometry>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.2985 0.132"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.132" length="0.075"/></geometry>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.2985 0.132"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- The LIDAR x axis points to the robot's left -->
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.225 0 0.21" rpy="0 0 1.5708"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.10 0 0.11" rpy="0 0 0"/>
  </joint>
</robot>
